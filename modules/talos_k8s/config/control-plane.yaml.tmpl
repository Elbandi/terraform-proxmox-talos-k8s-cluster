machine:
  install:
    disk: ${install_disk}
  network:
    hostname: ${hostname}
%{ if cluster_vip != null || custom_network != null ~}
    interfaces:
%{ endif ~}
%{ if cluster_vip != null ~}
      - deviceSelector:
          physical: true
        vip:
          ip: ${cluster_vip}
%{ endif ~}
%{ if custom_network != null ~}
      ${indent(6, custom_network)}
%{ endif ~}
# https://www.talos.dev/v1.7/talos-guides/configuration/time-sync/#additional-configuration
  time:
    servers:
      - %{ if time_server != null && time_server != "" }${time_server}%{ else }pool.ntp.org%{ endif }
  kubelet:
    nodeIP:
      validSubnets:
        - ${ cidrhost(format("%s/24", node_ip), 0) }/24
    extraArgs:
      rotate-server-certificates: true
  kernel:
    modules:
%{ if enable_lvm ~}
      - name: dm_thin_pool
%{ endif ~}
%{ for mod in kernel_modules ~}
      - name: ${mod}
%{ endfor ~}
  files:
    - content: |
        [metrics]
          address = "0.0.0.0:11234"
      path: /var/cri/conf.d/metrics.toml
      op: create
  features:
    kubePrism:
      enabled: true
      port: 7445
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
      - os:etcd:backup
      allowedKubernetesNamespaces:
      - default
      - kube-system

cluster:
  etcd:
    advertisedSubnets:
      - ${ cidrhost(format("%s/24", node_ip), 0) }/24
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
  scheduler:
    extraArgs:
      bind-address: 0.0.0.0
  extraManifests:
    - https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/main/deploy/standalone-install.yaml
  allowSchedulingOnControlPlanes: true
  network:
    cni:
      name: none
    podSubnets:
      - ${pod_subnet}
    serviceSubnets:
      - ${service_subnet}
  proxy:
    disabled: true
  inlineManifests:
%{ if enable_lvm ~}
  - name: lvm-setup
    contents: |
      ${indent(6, lvm_setup)}
%{ endif ~}
  - name: cilium-values
    contents: |
      ${indent(6, cilium_values)}
  - name: cilium-bootstrap
    contents: |
      ${indent(6, cilium_install)}
