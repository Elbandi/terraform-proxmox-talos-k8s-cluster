---
version: v1alpha1
machine:
  install:
    disk: ${install_disk}
%{ if !startswith(talos_version, "v1.12") ~}
  network:
    hostname: ${hostname}
%{ endif ~}
  time:
    servers:
      - %{ if time_server != null && time_server != "" }${time_server}%{ else }pool.ntp.org%{ endif }
  kubelet:
    extraArgs:
      rotate-server-certificates: true
  kernel:
    modules:
%{ for mod in kernel_modules ~}
      - name: ${mod}
%{ endfor ~}
  features:
    kubePrism:
      enabled: true
      port: 7445
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
      - os:etcd:backup
      allowedKubernetesNamespaces:
      - default
      - kube-system
  files:
    - content: |
        [metrics]
          address = "0.0.0.0:11234"
      path: /var/cri/conf.d/metrics.toml
      op: create

cluster:
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
  scheduler:
    extraArgs:
      bind-address: 0.0.0.0
  extraManifests:
    - https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/main/deploy/standalone-install.yaml
  allowSchedulingOnControlPlanes: ${allow_scheduling_on_control_planes}
  # Cilium CNI
  network:
    cni:
      name: none
  proxy:
    disabled: true
  # inline bootstrap manifests 
  inlineManifests:
  - name: cilium-values
    contents: |
      ${indent(6, cilium_values)}
  - name: cilium-bootstrap
    contents: |
      ${indent(6, cilium_install)}
%{ if startswith(talos_version, "v1.12") ~}
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: ${hostname}
auto: off
%{ if vip_ip != null ~}
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: ${vip_ip}
link: ${vip_interface}
%{ endif ~}
%{ endif ~}
