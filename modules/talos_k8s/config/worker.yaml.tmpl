---
version: v1alpha1
machine:
  install:
    disk: ${install_disk}
  time:
    servers:
      - /dev/ptp0
  kubelet:
    extraArgs:
      rotate-server-certificates: true
  features:
    kubePrism:
      enabled: true
      port: 7445
  files:
    - content: |
        [metrics]
          address = "0.0.0.0:11234"
      path: /var/cri/conf.d/metrics.toml
      op: create
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: stable