machine:
  install:
    disk: ${install_disk}
  network:
    hostname: ${hostname}
%{ if custom_network != null ~}
    interfaces:
      ${indent(6, custom_network)}
%{ endif ~}
    extraHostEntries:
%{ for ip, hosts in extra_hosts ~}
      - ip: ${ip}
        aliases:
%{ for host in hosts ~}
          - ${host}
%{ endfor ~}
%{ endfor ~}
# https://www.talos.dev/v1.7/talos-guides/configuration/time-sync/#additional-configuration
  time:
    servers:
      - %{ if time_server != null && time_server != "" }${time_server}%{ else }pool.ntp.org%{ endif }
  kubelet:
    nodeIP:
      validSubnets:
        - ${ cidrhost(format("%s/24", node_ip), 0) }/24
    extraArgs:
%{ if cloud_provider != "none" ~}
      cloud-provider: external
%{ endif ~}
      rotate-server-certificates: true
  kernel:
    modules:
%{ if enable_lvm ~}
      - name: dm_thin_pool
%{ endif ~}
%{ for mod in kernel_modules ~}
      - name: ${mod}
%{ endfor ~}
%{ for mod in kernel_modules ~}
      - name: ${mod}
%{ endfor ~}
  registries:
    config:
%{ for host, auth in registries ~}
      "${host}":
        auth:
          username: ${auth.username}
          password: ${auth.password}
%{ endfor ~}
  files:
    - content: |
        [metrics]
          address = "0.0.0.0:11234"
      path: /var/cri/conf.d/metrics.toml
      op: create
  udev:
    # List of udev rules to apply to the udev system
    rules:
%{ for u, n in disk_uuid ~}
      - SUBSYSTEM=="block", KERNEL=="sd*", ENV{DEVTYPE}=="disk", ENV{ID_WWN_WITH_EXTENSION}=="0x${u}", SYMLINK+="disk/by-id/scsi-${n}"
%{ endfor ~}
  nodeLabels:
%{ for k, v in node_labels ~}
    ${k}: ${v}
%{ endfor ~}
